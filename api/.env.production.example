# ---------------------------------------------------------------------------
# ProcureFlow — environment template for PRODUCTION (Railway + Supabase).
# Set these as Railway environment variables — do NOT commit real values.
# ---------------------------------------------------------------------------

# Supabase PostgreSQL connection string.
# Find this in: Supabase Dashboard → Settings → Database → Connection string → URI
# Use the "Session mode" (port 5432) connection string.
# Example: postgresql://postgres.abcxyz:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Auth — MUST change for production
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# Password for the four demo accounts (set only if seeding)
DEMO_PASSWORD=demo1234

# CORS — your deployed frontend URL on Railway
# Example: https://procureflow-web-production.up.railway.app
CORS_ORIGINS=

# LLM (optional — leave empty to use deterministic fallback)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Sentence-transformers model for embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Set to "true" on the FIRST deploy to seed demo data, then remove
SEED_ON_DEPLOY=false
